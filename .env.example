# Copy to .env.local for local dev. NEVER commit real secrets.
# On Vercel: Project → Settings → Environment Variables → add each of these.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_YOUR_ANON_KEY
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
VITE_GOOGLE_AUTH_PROXY=https://designarena.ai/auth/google/callback
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_YOUR_ANON_KEY
# Server-only (Vercel env, never VITE_ prefix, never commit):
SUPABASE_SERVICE_ROLE_KEY=sb_secret_YOUR_SERVICE_ROLE_KEY
# Admin allowlist — ONLY these emails can use /admin and the write APIs:
ADMIN_EMAILS=you@example.com
VITE_ADMIN_EMAILS=you@example.com
# Contact email alerts (Resend) — server-only:
RESEND_API_KEY=re_YOUR_KEY
NOTIFY_EMAIL=you@example.com
RESEND_FROM=Portfolio <onboarding@resend.dev>
# Analytics (Umami Cloud) + error tracking (Sentry) — public, VITE_ prefix:
VITE_UMAMI_WEBSITE_ID=
VITE_UMAMI_SRC=https://cloud.umami.is/script.js
VITE_SENTRY_DSN=
